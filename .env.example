SCA_API_KEY=sk-your-key-here
SCA_API_BASE=https://api.deepseek.com
SCA_MODEL=deepseek-v4-pro
SCA_MAX_TOKENS=128000
SCA_MAX_OUTPUT_TOKENS=8192
SCA_LLM_READ_TIMEOUT=120
SCA_WORKSPACE=.
SCA_MAX_ACTORS=4
# Content detection defaults to deterministic local rules. Hybrid/strict use a
# separately installed preview dependency and a dedicated trust-domain key.
SCA_SECURITY_MODE=local
# SCA_GUARDRAILS_CONFIG=C:\trusted\openai-guardrails-coding.json
# SCA_GUARDRAILS_API_KEY=dedicated-guardrails-key
# SCA_GUARDRAILS_BASE_URL=https://api.openai.com/v1
# SCA_GUARDRAILS_MODEL=gpt-4.1-mini
# SCA_GUARDRAILS_TIMEOUT=10
# SCA_GUARDRAILS_MAX_CONCURRENCY=4
SCA_SANDBOX_BACKEND=e2b
E2B_API_KEY=e2b_your_key_here
SCA_E2B_TEMPLATE=base
SCA_E2B_ALLOW_INTERNET=false
SCA_SANDBOX_MAX_TIMEOUT=300
SCA_SANDBOX_MAX_TRANSFER=50000000
